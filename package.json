{
  "name": "music-nest",
  "version": "1.0.0",
  "private": true,
  "description": "清新脱俗的个人音乐小窝 · A fresh personal music nest",
  "type": "module",
  "scripts": {
    "api": "NeteaseCloudMusicApi",
    "dev:web": "vite",
    "dev": "concurrently -n API,WEB -c magenta,cyan \"npm:api\" \"npm:dev:web\"",
